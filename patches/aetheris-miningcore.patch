+++ b/vendor/rmt-miningcore/src/Miningcore/Blockchain/Bitcoin/Custom/AetherisBitcoinJob.cs
@@
+namespace Miningcore.Blockchain.Bitcoin.Custom;
+
+/// <summary>
+/// Aetheris currently uses Bitcoin-style PoW templates with Scrypt headers,
+/// timestamped transactions, and a serialized block-signature vector.
+/// </summary>
+public sealed class AetherisBitcoinJob : BitcoinJob
+{
+    protected override bool IncludeCoinbaseTimestamp => true;
+
+    // A PoW block has an empty vchBlockSig vector; CompactSize(0) is one zero byte.
+    protected override bool IncludeBlockSignature => true;
+
+    // The active Aetheris protocol rules currently permit 15 seconds of future drift.
+    // The coinbase time is fixed in Stratum's job, so keep submitted header time
+    // within that consensus window of the template's coinbase timestamp.
+    protected override bool IsValidShareTime(uint nTime) =>
+        nTime >= BlockTemplate.CurTime &&
+        (ulong) nTime <= (ulong) BlockTemplate.CurTime + 15UL;
+}
*** End Patch
